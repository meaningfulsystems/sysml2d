          "width": 258,
          "height": 103,
          "z": 10
        },
        "label": "\u00abrequirement\u00bb\nTwo Block II guidance computers.\nCommand Module entry programs\nare not Lunar Module landing\nprograms.",
        "style": "requirement"
      },
      {
        "id": "rsoRequirement",
        "model_ref": "rsoRequirement",
        "symbol": "requirement",
        "layout": {
          "x": 370,
          "y": 72,
          "width": 237,
          "height": 103,
          "z": 10
        },
        "label": "\u00abrequirement\u00bb\nCrew safety is not Launch\nEscape System only. The Range\nSafety Officer sits outside\nMission Control.",
        "style": "requirement"
      },
      {
        "id": "spsRequirement",
        "model_ref": "spsRequirement",
        "symbol": "requirement",
        "layout": {
          "x": 647,
          "y": 72,
          "width": 230,
          "height": 88,
          "z": 10
        },
        "label": "\u00abrequirement\u00bb\nService Propulsion sources\ndisagree on vacuum thrust.\nThere is no required thrust.",
        "style": "requirement"
      },
      {
        "id": "dpsRequirement",
        "model_ref": "dpsRequirement",
        "symbol": "requirement",
        "layout": {
          "x": 917,
          "y": 72,
          "width": 258,
          "height": 88,
          "z": 10
        },
        "label": "\u00abrequirement\u00bb\nDescent Propulsion sources\ndisagree on thrust and throttle.\nThere is no required thrust.",
        "style": "requirement"
      },
      {
        "id": "lm5ConsumableRequirement",
        "model_ref": "lm5ConsumableRequirement",
        "symbol": "requirement",
        "layout": {
          "x": 72,
          "y": 224,
          "width": 244,
          "height": 88,
          "z": 10
        },
        "label": "\u00abrequirement\u00bb\nLunar Module descent oxygen\nis a teaching figure.\nThere is no required pressure.",
        "style": "requirement"
      },
      {
        "id": "recoveryRequirement",
        "model_ref": "recoveryRequirement",
        "symbol": "requirement",
        "layout": {
          "x": 356,
          "y": 239,
          "width": 244,
          "height": 103,
          "z": 10
        },
        "label": "\u00abrequirement\u00bb\nSplash is the flown Ground\nElapsed Time. Distance is from\nthe recovery ship, not the\ntarget.",
        "style": "requirement"
      },
      {
        "id": "pngsRequirement",
        "model_ref": "pngsRequirement",
        "symbol": "requirement",
        "layout": {
          "x": 640,
          "y": 254,
          "width": 237,
          "height": 118,
          "z": 10
        },
        "label": "\u00abrequirement\u00bb\nPrimary Guidance, Navigation,\nand Control is not Abort\nGuidance. Landing radar is on\ndescent; rendezvous radar is\non ascent.",
        "style": "requirement"
      },
      {
        "id": "isolationRequirement",
