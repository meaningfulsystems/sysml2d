          "y": 72,
          "width": 237,
          "height": 156,
          "z": 10
        },
        "label": "\u00abrequirement\u00bb\nLand\nThe Lunar Module shall land\ntwo crew on the Moon under\nPrimary Guidance program P66.",
        "style": "requirement"
      },
      {
        "id": "talk",
        "model_ref": "talk",
        "symbol": "requirement",
        "layout": {
          "x": 597,
          "y": 72,
          "width": 223,
          "height": 156,
          "z": 10
        },
        "label": "\u00abrequirement\u00bb\nTalk\nThe stack shall communicate\nwith Mission Control on\nUnified S-Band.",
        "style": "requirement"
      },
      {
        "id": "abort",
        "model_ref": "abort",
        "symbol": "requirement",
        "layout": {
          "x": 72,
          "y": 284,
          "width": 230,
          "height": 156,
          "z": 10
        },
        "label": "\u00abrequirement\u00bb\nAbort\nThe Abort Guidance System\nshall provide abort guidance\nwithout landing the Lunar\nModule.",
        "style": "requirement"
      },
      {
        "id": "air",
