{
  "$schema": "../../schemas/sysmld.schema.json",
  "version": "0.1",
  "mode": "model_based",
  "model_files": [
    "apollo.sysml"
  ],
  "aliases": {
    "AGSMode": "Apollo11::AGSMode",
    "idle": "Apollo11::AGSMode::idle",
    "operate": "Apollo11::AGSMode::operate",
    "followPNGS": "Apollo11::AGSMode::followPNGS",
    "agsOn": "Apollo11::AGSMode::agsOn",
    "r47": "Apollo11::AGSMode::r47",
    "agsOff": "Apollo11::AGSMode::agsOff"
  },
  "diagram": {
    "id": "apollo-stm-ags",
    "kind": "StateView",
    "name": "AGS modes",
    "canvas": {
      "width": 996,
      "height": 290,
      "background": "#FFFFFF"
    },
    "frame": {
      "visible": true
    },
    "elements": [
      {
        "id": "boundary",
        "model_ref": "AGSMode",
        "symbol": "boundary",
        "layout": {
          "x": 114,
          "y": 98,
          "width": 842,
          "height": 152,
          "z": 0
        },
        "compartments": {
          "attributes": false,
          "ports": false,
          "actions": false
        },
        "style": "boundary.system"
      },
      {
        "id": "initial",
        "symbol": "initial_state",
        "layout": {
          "x": 150,
          "y": 150,
          "width": 20,
          "height": 20,
          "z": 10
        },
        "style": "initial_state"
      },
      {
        "id": "idle",
        "symbol": "state_usage",
        "layout": {
          "x": 320,
          "y": 134,
          "width": 140,
          "height": 52,
          "z": 10
        },
        "model_ref": "idle",
        "label": "AGS idle",
        "style": "state.default"
      },
      {
        "id": "operate",
        "symbol": "state_usage",
        "layout": {
          "x": 550,
          "y": 134,
          "width": 140,
          "height": 52,
          "z": 10
        },
        "model_ref": "operate",
        "label": "AGS operate",
        "style": "state.default"
      },
      {
        "id": "followPNGS",
        "symbol": "state_usage",
        "layout": {
          "x": 780,
          "y": 134,
          "width": 140,
          "height": 52,
          "z": 10
        },
        "model_ref": "followPNGS",
        "label": "follow PNGS",
        "style": "state.default"
      }
    ],
    "connections": [
      {
        "id": "initial--idle",
        "model_ref": "AGSMode",
        "source": {
          "element": "initial",
          "anchor": {
            "side": "right",
            "offset": 0.5
          }
        },
        "target": {
          "element": "idle",
          "anchor": {
            "side": "left",
            "offset": 0.5
          }
        },
        "route": {
          "kind": "orthogonal",
          "waypoints": []
        },
        "labels": [],
        "style": "transition"
      },
      {
        "id": "idle--operate",
        "model_ref": "agsOn",
        "source": {
          "element": "idle",
          "anchor": {
            "side": "right",
            "offset": 0.5
          }
        },
        "target": {
          "element": "operate",
          "anchor": {
            "side": "left",
            "offset": 0.5
          }
        },
        "route": {
          "kind": "orthogonal",
          "waypoints": []
        },
        "labels": [
          {
            "text": "on",
            "position": {
              "segment": 0,
              "offset": 0.5,
              "placement": "centerline"
            }
          }
        ],
        "style": "transition"
      },
      {
        "id": "operate--followPNGS",
        "model_ref": "r47",
        "source": {
          "element": "operate",
          "anchor": {
            "side": "right",
            "offset": 0.5
          }
        },
        "target": {
          "element": "followPNGS",
          "anchor": {
            "side": "left",
            "offset": 0.5
          }
        },
        "route": {
          "kind": "orthogonal",
          "waypoints": []
