    ],
    "annotations": [],
    "styles": {
      "boundary.system": {
        "fill": "#FFFFFF",
        "stroke": "#334155",
        "stroke_width": 2,
        "corner_radius": 12
      },
      "state.default": {
        "fill": "#EFF6FF",
        "stroke": "#1D4ED8",
        "stroke_width": 2,
        "corner_radius": 16
      },
      "initial_state": {
        "fill": "#1E293B",
        "stroke": "#1E293B",
        "stroke_width": 1
      },
      "final_state": {
        "fill": "#1E293B",
        "stroke": "#1E293B",
        "stroke_width": 2
      },
      "transition": {
        "stroke": "#1D4ED8",
        "stroke_width": 1.5,
        "corner_radius": 8,
        "marker_end": "arrow"
