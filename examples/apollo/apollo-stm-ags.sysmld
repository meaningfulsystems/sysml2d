        "source": {
          "element": "operate",
          "anchor": {
            "side": "bottom",
            "offset": 0.5
          }
        },
        "target": {
          "element": "idle",
          "anchor": {
            "side": "bottom",
            "offset": 0.5
          }
        },
        "route": {
