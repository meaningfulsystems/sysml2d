    "name": "Blender Requirements",
    "canvas": {
      "width": 1828,
      "height": 628,
      "background": "#FFFFFF"
    },
    "frame": {
      "visible": true
    },
    "elements": [
      {
        "id": "lidInterlockRequirement",
        "model_ref": "lidInterlockRequirement",
        "symbol": "requirement",
        "layout": {
          "x": 795.5,
          "y": 72,
          "width": 237,
          "height": 88,
          "z": 10
        },
        "label": "\u00abrequirement\u00bb\nREQ-B-001 Lid Interlock\nMotor shall not run unless\nthe lid is seated and locked.",
        "style": "requirement"
      },
      {
        "id": "motorControlRequirement",
        "model_ref": "motorControlRequirement",
        "symbol": "requirement",
        "layout": {
          "x": 209,
          "y": 270,
          "width": 195,
          "height": 88,
          "z": 10
        },
        "label": "\u00abrequirement\u00bb\nREQ-B-002 Motor Control\nStart, pause, and stop\nwithin 200 ms.",
        "style": "requirement"
      },
      {
        "id": "smoothnessDetectionRequirement",
        "model_ref": "smoothnessDetectionRequirement",
        "symbol": "requirement",
        "layout": {
          "x": 613,
          "y": 270,
          "width": 265,
          "height": 88,
          "z": 10
        },
        "label": "\u00abrequirement\u00bb\nREQ-B-003 Smoothness Detection\nUse sensor feedback to stop\nwhen smoothness threshold is met.",
        "style": "requirement"
      },
      {
        "id": "powerRequirement",
        "model_ref": "powerRequirement",
        "symbol": "requirement",
        "layout": {
          "x": 950,
          "y": 270,
          "width": 202,
          "height": 88,
          "z": 10
        },
        "label": "\u00abrequirement\u00bb\nREQ-B-004 Power\nOperate within the rated\npower envelope.",
        "style": "requirement"
      },
      {
        "id": "interlockLatencyRequirement",
        "model_ref": "interlockLatencyRequirement",
        "symbol": "requirement",
        "layout": {
          "x": 1224,
          "y": 270,
          "width": 223,
          "height": 88,
          "z": 10
        },
        "label": "\u00abrequirement\u00bb\nREQ-B-010 Interlock Latency\nDisable motor within 50 ms\nof lid-removal detection.",
        "style": "requirement"
      },
      {
        "id": "motorSpeedRequirement",
        "model_ref": "motorSpeedRequirement",
        "symbol": "requirement",
        "layout": {
          "x": 72,
          "y": 468,
          "width": 209,
          "height": 88,
          "z": 10
        },
        "label": "\u00abrequirement\u00bb\nREQ-B-020 Motor Speed\nMaintain set speed within\n\u00b110% on normal loads.",
        "style": "requirement"
      },
      {
        "id": "overcurrentProtectionRequirement",
        "model_ref": "overcurrentProtectionRequirement",
        "symbol": "requirement",
        "layout": {
          "x": 353,
          "y": 468,
          "width": 188,
          "height": 88,
          "z": 10
        },
        "label": "\u00abrequirement\u00bb\nREQ-B-021 Overcurrent\nCut power before motor\ndamage occurs.",
        "style": "requirement"
      },
      {
        "id": "smoothnessThresholdRequirement",
        "model_ref": "smoothnessThresholdRequirement",
        "symbol": "requirement",
        "layout": {
          "x": 623.5,
          "y": 468,
          "width": 244,
          "height": 88,
          "z": 10
        },
        "label": "\u00abrequirement\u00bb\nREQ-B-030 Smoothness Threshold\nConfigurable for at least\nthree blend program profiles.",
        "style": "requirement"
      },
      {
        "id": "noiseRequirement",
        "model_ref": "noiseRequirement",
        "symbol": "requirement",
        "layout": {
          "x": 960.5,
          "y": 468,
          "width": 181,
          "height": 88,
          "z": 10
        },
        "label": "\u00abrequirement\u00bb\nREQ-B-040 Noise\nBelow 85 dB(A) at the\noperator position.",
        "style": "requirement"
      },
      {
        "id": "containerSeatRequirement",
        "model_ref": "containerSeatRequirement",
        "symbol": "requirement",
        "layout": {
          "x": 1519,
          "y": 270,
          "width": 237,
          "height": 88,
          "z": 10
        },
        "label": "\u00abrequirement\u00bb\nREQ-B-050 Container Seat\nLock to the motor base;\ndeliberate action to release.",
        "style": "requirement"
      }
