          "y": 666,
          "width": 216,
          "height": 88,
          "z": 10
        },
        "label": "\u00abrequirement\u00bb\nREQ-T-030 Crumb Tray Force\nRemoval force no more\nthan 10 N.",
        "style": "requirement"
      },
