          "height": 88,
          "z": 10
        },
        "label": "\u00abrequirement\u00bb\nREQ-T-011 Surface Temp\nAccessible exteriors shall stay\nwithin safe touch limits.",
        "style": "requirement"
      },
      {
        "id": "thermalCutoffRequirement",
