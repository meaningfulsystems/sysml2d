          "y": 270,
          "width": 223,
          "height": 88,
          "z": 10
        },
        "label": "\u00abrequirement\u00bb\nREQ-T-004 Toast Timing\nHeating duration within \u00b15%\nof the selected setting.",
        "style": "requirement"
      },
      {
        "id": "powerRatingRequirement",
