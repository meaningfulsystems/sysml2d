        "symbol": "requirement",
        "layout": {
          "x": 855,
          "y": 72,
          "width": 209,
          "height": 88,
          "z": 10
        },
        "label": "\u00abrequirement\u00bb\nREQ-T-001 Toast Safety\nPrevent exposed energized\nor overheating hazards.",
        "style": "requirement"
      },
      {
        "id": "electricalSafetyRequirement",
        "model_ref": "electricalSafetyRequirement",
        "symbol": "requirement",
        "layout": {
          "x": 395,
          "y": 270,
          "width": 258,
          "height": 88,
          "z": 10
        },
        "label": "\u00abrequirement\u00bb\nREQ-T-002 Electrical Safety\nComply with applicable household\nappliance electrical standards.",
        "style": "requirement"
      },
      {
        "id": "browningRequirement",
        "model_ref": "browningRequirement",
        "symbol": "requirement",
        "layout": {
          "x": 1048,
          "y": 270,
          "width": 223,
          "height": 88,
          "z": 10
        },
        "label": "\u00abrequirement\u00bb\nREQ-T-003 Browning Quality\nDeliver selectable browning\nwithout burning bread.",
        "style": "requirement"
      },
      {
